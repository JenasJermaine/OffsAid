DATABASE_URL=postgresql+psycopg://offsaid:offsaid@localhost:5432/offsaid
LOOKUP_HASH_SALT=change-me-in-production
FOUND_MIN_SCORE=92
POSSIBLE_MIN_SCORE=80
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
NETWORK_CHECKS_ENABLED=true
# WhatsApp Cloud API (Meta). Empty WHATSAPP_TOKEN = replies are logged, not sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Twilio WhatsApp. Empty TWILIO_AUTH_TOKEN = replies are logged, not sent.
# Incoming messages: POST /twilio/webhook
# TWILIO_WHATSAPP_FROM keeps the whatsapp: prefix, e.g. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Web-checking agent limits per case
WEB_AGENT_MAX_TOOL_CALLS=12
WEB_AGENT_TIMEOUT_SECONDS=180
WEB_AGENT_EFFORT=low
# Unpacked scam-language model (not in git). Missing folder: the check stays up
# and only the fee-wording rule runs (the response mode is rules_only).
OFFSAID_MODEL_DIR=models/offsaid_classifier_v4
# Optional hosted classifier (for example, Modal). Set both values to use it instead of local weights.
SCAM_MODEL_API_URL=
SCAM_MODEL_API_TOKEN=
SCAM_MODEL_TIMEOUT_SECONDS=120
# Cross-case linking (needs Postgres 14+ with pg_trgm; on SQLite the report says it was not available).
# HMAC key for phone numbers, payment accounts and emails, at least 32 characters. Generate once:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Treat it as PERMANENT: raw values are not stored, so losing or changing it makes every stored hash
# unmatchable (wipe the linking tables and re-seed). Keep it in the team's secret store; never commit it.
OFFSAID_HASH_KEY=
# Linking runs per WhatsApp user per hour (stops the bot being used to probe the database).
LINKING_MAX_PER_HOUR=10
# KEFWA reviewer routes under /admin (HTTP Basic). Empty password = routes disabled.
ADMIN_USERNAME=kefwa
ADMIN_PASSWORD=
# Browser demo of the WhatsApp chat at /demo. Turn off in production.
DEMO_CHAT_ENABLED=true
